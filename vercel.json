{
  "crons": [
    {
      "path": "/api/admin/calendar/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/sessions/extend",
      "schedule": "32 5 * * *"
    },
    {
      "path": "/api/admin/reminders/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin/reminders/run?backup=1",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/admin/payment-prompts/run",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/admin/maintenance/purge-tokens",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/maintenance/purge-clinical",
      "schedule": "0 4 1 * *"
    }
  ]
}
